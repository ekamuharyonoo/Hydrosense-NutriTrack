# Salin menjadi .env.local (cp env.example .env.local) lalu isi.
# Semua nilai di sini hanya dibaca SERVER Next.js — tidak ada yang dikirim ke browser.

# ---- Server Next.js ⇄ broker MQTT (recorder + bridge) ----
# Produksi: mqtts://mqtt.webeka.my.id:8883 dengan akun 'hydrosense-server'
# (baca hydrosense/+/#, tulis hydrosense/+/cmd — lihat mosquitto/setup-dynsec.sh).
RECORDER_MQTT_URL=mqtts://mqtt.webeka.my.id:8883
RECORDER_MQTT_USERNAME=hydrosense-server
RECORDER_MQTT_PASSWORD=ganti-password-server
RECORDER_TOPIC_ROOT=hydrosense
HYDROSENSE_DB_PATH=./data/hydrosense.db

# ---- Alamat publik web (tautan email, login Google, QR label) ----
APP_URL=https://hydrosense.webeka.my.id

# ---- Token alat produksi (tools/provision). Buat acak: openssl rand -base64 32 ----
PROVISION_TOKEN=

# ---- Email (opsional). Kosong = verifikasi email & lupa password ditangani admin ----
# Contoh Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_PASS = App Password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="HydroSense <no-reply@webeka.my.id>"

# ---- Login Google (opsional) ----
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
# Authorized redirect URI: <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Hanya untuk `npm run simulate` (simulator ESP Master di laptop) ----
SIM_MQTT_URL=mqtts://mqtt.webeka.my.id:8883
SIM_MQTT_USERNAME=HSM-000000000001
SIM_MQTT_PASSWORD=ganti-password-simulator
SIM_MQTT_TOPIC=hydrosense/HSM-000000000001
